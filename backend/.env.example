# Application
APP_NAME="AI Financial Copilot"
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./financial_copilot.db

# Auth
AUTH_SECRET_KEY=change_this_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of frontend origins allowed to call this API.
# Set to your real deployed frontend origin(s) in production. Never use "*".
FRONTEND_URL=http://localhost:5173

# Google Gemini (for AI Copilot - set when implementing AI integration)
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
